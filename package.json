{
  "name": "oc-machine",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "description": "Machines for OpenCode: SSH config, sudo, env vars and a per-agent permission table",
  "exports": {
    ".": "./plugin/index.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "plugin/*.ts",
    "plugin/*.tsx",
    "!plugin/*.test.ts",
    "dist/gui-experimental.cjs",
    "vendor",
    "scripts/*.mjs",
    "docs",
    "README.md",
    "pixi.toml",
    "pixi.lock",
    "npm-shrinkwrap.json",
    "tsconfig.json",
    "vite.config.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --import tsx --test plugin/*.test.ts",
    "build": "vite build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.6",
    "jsonc-parser": "3.3.1",
    "oc-secure-kit": "file:vendor/oc-secure-kit-0.2.0.tgz"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "solid-js": "1.9.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vite-plugin-solid": "2.11.15"
  }
}
